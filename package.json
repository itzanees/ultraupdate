{
  "name": "ultratek-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:local:generate": "prisma generate --schema=prisma/schema.local.prisma",
    "db:local:migrate": "prisma migrate dev --schema=prisma/schema.local.prisma",
    "db:prod:deploy": "prisma migrate deploy",
    "dev": "next dev",
    "build": "next build && shx cp -r public .next/standalone/ && shx cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "shx": "^0.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
